NODE_ENV=development
# The whole project runs on Vietnam time
TZ=Asia/Ho_Chi_Minh
PORT=4000
FRONTEND_URL=http://localhost:3000
# Database. Local: points at the db-profile containers through localhost.
# Server: fill in the real database, like yoslot (DB_HOST = domain or IP of the database server).
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=xoidich
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
LOG_LEVEL=debug
# Folder for daily log files (app.YYYY-MM-DD.N.log). Leave empty to log to the console only.
LOG_DIR=
LOG_RETENTION_DAYS=30
# E2E tests: same DB server, separate database / Redis DB (wiped before each run)
TEST_DB_DATABASE=xoidich_test
TEST_REDIS_DB=1
